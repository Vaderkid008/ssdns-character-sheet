{
  "rules": {
    "rooms": {
      "$roomCode": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('dmUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['code', 'dmUid', 'createdAt', 'status'])"
        },
        "players": {
          ".read": "auth != null",
          "$playerId": {
            ".read": "auth != null",
            ".write": "auth != null && (auth.uid === $playerId || root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid)",
            "snapshot": {
              ".validate": "newData.hasChildren(['name', 'updatedAt'])"
            }
          }
        },
        "ledger": {
          ".read": "auth != null",
          "$entryId": {
            ".write": "auth != null && (!data.exists() || root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['ts', 'type', 'who'])"
          }
        },
        "rolls": {
          ".read": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid",
          "$rollId": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['ts', 'who', 'result'])"
          }
        },
        "messages": {
          ".read": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid",
          "$messageId": {
            ".read": "auth != null && (root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid || data.child('to').val() === auth.uid || data.child('to').val() === 'all' || data.child('from').val() === auth.uid)",
            ".write": "auth != null && (!data.exists() && newData.child('from').val() === auth.uid || data.exists() && (data.child('to').val() === auth.uid || root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['ts', 'from', 'to', 'text'])"
          }
        },
        "handouts": {
          ".read": "auth != null",
          "$handoutId": {
            ".write": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['ts', 'name']) && (newData.child('url').val() !== '' || newData.child('text').val() !== '')"
          }
        },
        "commands": {
          ".read": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid",
          "$cmdId": {
            ".write": "auth != null && (root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid || (data.exists() && (data.child('to').val() === auth.uid || data.child('to').val() === 'all')))",
            ".validate": "newData.hasChildren(['ts', 'type'])"
          }
        },
        "broadcast": {
          ".read": "auth != null",
          "$cmdId": {
            ".write": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['ts', 'type']) && (!newData.child('to').exists() || newData.child('to').val() === 'all' || newData.child('to').val() === '')"
          }
        },
        "inbox": {
          "$playerId": {
            ".read": "auth != null && (auth.uid === $playerId || root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid)",
            "$cmdId": {
              ".write": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid",
              ".validate": "newData.hasChildren(['ts', 'type']) && newData.child('to').val() === $playerId"
            }
          }
        },
        "table": {
          ".read": "auth != null",
          "initiative": {
            ".write": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid"
          },
          "store": {
            ".write": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid"
          },
          "packs": {
            ".write": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid"
          },
          "updatedAt": {
            ".write": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid"
          },
          "inspiration": {
            ".write": "auth != null && (root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid || (newData.child('count').isNumber() && newData.child('count').val() >= 0 && newData.child('count').val() <= 99 && data.child('count').isNumber() && newData.child('count').val() === data.child('count').val() - 1 && newData.child('last/delta').val() === -1 && newData.child('last/by').val() === auth.uid))"
          },
          "storeOpen": {
            ".write": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid"
          },
          "damageMode": {
            ".write": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid"
          }
        },
        "tableFeed": {
          ".read": "auth != null",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('from').val() === auth.uid",
            ".validate": "newData.hasChildren(['ts', 'from', 'text']) && !newData.hasChild('hp') && !newData.hasChild('maxHp')"
          }
        },
        "playerInit": {
          "$playerId": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $playerId",
            ".validate": "newData.hasChildren(['ts', 'init', 'name'])"
          },
          ".read": "auth != null"
        },
        "conditions": {
          ".read": "auth != null",
          "$id": {
            ".write": "auth != null && (root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid || (newData.exists() && newData.child('subjectKind').val() === 'player' && newData.child('subjectId').val() === auth.uid) || (!newData.exists() && data.child('subjectKind').val() === 'player' && data.child('subjectId').val() === auth.uid))",
            ".validate": "!newData.exists() || (newData.hasChildren(['name', 'subjectId', 'subjectKind', 'updatedAt']) && (newData.child('subjectKind').val() === 'player' || newData.child('subjectKind').val() === 'enemy'))"
          }
        },
        "encounter": {
          "public": {
            ".read": "auth != null",
            "$id": {
              ".validate": "newData.hasChildren(['name']) && !newData.hasChild('hp') && !newData.hasChild('maxHp')"
            },
            ".write": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid"
          },
          "hp": {
            ".read": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid",
            ".write": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid"
          },
          "requests": {
            ".read": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid",
            "$id": {
              ".write": "auth != null && !data.exists() && newData.child('from').val() === auth.uid",
              ".validate": "newData.hasChildren(['ts', 'from', 'targetId', 'amount']) && !newData.hasChild('hp') && !newData.hasChild('maxHp')"
            }
          }
        },
        "chat": {
          ".read": "auth != null",
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (data.exists() && !newData.exists() && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid))",
            ".validate": "!newData.exists() || (newData.hasChildren(['ts', 'from', 'text']) && (!newData.child('to').exists() || newData.child('to').val() === 'all' || newData.child('to').val() === ''))"
          }
        },
        "archives": {
          ".read": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid",
          ".write": "auth != null && root.child('rooms/'+$roomCode+'/meta/dmUid').val() === auth.uid"
        }
      }
    }
  }
}